    {"link_id": "M3-HQ-Dist-to-HQ-Acc2",      "source_node": "HQ-Dist-SW1",  "destination_node": "HQ-Acc-SW2",     "distance_m": 45},
    {"link_id": "M4-HQ-Core-to-Branch1",       "source_node": "HQ-Core-RTR",  "destination_node": "BR1-Edge-RTR",   "distance_m": 15000},
    {"link_id": "M5-HQ-Core-to-Branch2",       "source_node": "HQ-Core-RTR",  "destination_node": "BR2-Edge-RTR",   "distance_m": 35000},
    {"link_id": "M6-BR1-Edge-to-BR1-SW",       "source_node": "BR1-Edge-RTR", "destination_node": "BR1-Acc-SW1",    "distance_m": 20},
    {"link_id": "M7-BR2-Edge-to-BR2-SW",       "source_node": "BR2-Edge-RTR", "destination_node": "BR2-Acc-SW1",    "distance_m": 25}
  ]
